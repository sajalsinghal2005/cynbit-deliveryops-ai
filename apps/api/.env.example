# PostgreSQL Connection URL
# Replace the placeholders with your actual PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizops_db?schema=public"

# Cookie / Session Secret for signing and HMAC validation (Must be at least 32 characters in production)
SESSION_SECRET="dev-session-cookie-secret-min-32-chars-change-for-production"

# Trusted Frontend Origin for Credentialed CORS
FRONTEND_URL="http://localhost:5173"

# Node Environment & Server Configuration
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"
LOG_LEVEL="info"
RATE_LIMIT_MAX_PER_MINUTE=300

# Trusted Frontend Origin for Credentialed CORS
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS=""

# Email Integration (Phase 9)
# EMAIL_PROVIDER: "simulation" | "resend"
EMAIL_PROVIDER="simulation"
RESEND_API_KEY=""
EMAIL_FROM="BizOps AI <billing@bizops.ai>"
EMAIL_WEBHOOK_SECRET=""
EMAIL_TIMEOUT_MS=5000

# LLM Orchestration (Phase 10)
# LLM_PROVIDER: "deterministic" | "openai" | "anthropic" | "gemini"
LLM_PROVIDER="deterministic"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
LLM_TIMEOUT_MS=10000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_TOOL_ITERATIONS=3

# Development Seed Passwords (Used ONLY in development seed script)
DEV_ADMIN_PASSWORD="AdminDevelopmentPassword123!"
DEV_APPROVER_PASSWORD="ApproverDevelopmentPassword123!"
DEV_OPERATOR_PASSWORD="OperatorDevelopmentPassword123!"
