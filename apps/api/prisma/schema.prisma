datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CustomerStatus {
  active
  inactive
  lead
}

enum InvoiceStatus {
  paid
  pending
  overdue
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalActionType {
  SEND_INVOICE_REMINDER
  REFUND_PAYMENT
  CANCEL_ORDER
}

enum ExecutionStatus {
  NOT_EXECUTED
  SUCCESS
  FAILED
}

model Customer {
  id            String         @id
  name          String
  company       String
  email         String
  avatar        String
  totalSpend    String
  ordersCount   Int
  status        CustomerStatus @default(active)
  aiHealthScore Int
  lastActive    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  invoices         Invoice[]
  approvalRequests ApprovalRequest[]
  projects         Project[]

  @@map("customers")
}

model Invoice {
  id            String        @id
  invoiceNumber String        @unique
  clientName    String
  clientCompany String
  issueDate     String
  dueDate       String
  amount        String
  rawAmount     Float
  currency      String        @default("INR")
  status        InvoiceStatus @default(pending)
  paidDate      String?
  autoRemind    Boolean       @default(false)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("invoices")
}

model ApprovalRequest {
  id                String             @id
  title             String
  description       String
  actionType        ApprovalActionType
  toolName          String
  arguments         Json
  reason            String
  customer          String
  amount            String?
  risk              ApprovalRisk       @default(MEDIUM)
  relatedInvoiceId  String?
  relatedCustomerId String?
  relatedCustomer   Customer?          @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  status            ApprovalStatus     @default(PENDING)
  createdAt         DateTime           @default(now())
  decidedAt         DateTime?
  decidedBy         String?
  executionStatus   ExecutionStatus    @default(NOT_EXECUTED)
  executionResult   Json?

  auditEvents       AuditEvent[]

  @@map("approval_requests")
}

model AuditEvent {
  id                String           @id @default(cuid())
  approvalRequestId String?
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  eventType         String
  actor             String
  payload           Json
  timestamp         DateTime         @default(now())

  @@map("audit_events")
}

enum UserRole {
  ADMIN
  OPERATOR
  APPROVER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(OPERATOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]

  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  sessionTokenHash String   @unique
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  userAgent        String?
  ipAddress        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ProjectStatus {
  active
  on_track
  at_risk
  delayed
  completed
}

enum MilestoneStatus {
  pending
  in_progress
  completed
  delayed
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerStatus {
  open
  in_progress
  resolved
}

model Project {
  id           String        @id
  name         String
  description  String?
  status       ProjectStatus @default(active)
  healthScore  Int           @default(100)
  deliveryLead String
  techStack    String[]      @default([])
  budget       String?
  startDate    String
  targetDate   String
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones   Milestone[]
  blockers     Blocker[]

  @@map("projects")
}

model Milestone {
  id              String          @id
  title           String
  description     String?
  dueDate         String
  status          MilestoneStatus @default(pending)
  progressPercent Int             @default(0)
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  blockers        Blocker[]

  @@map("milestones")
}

model Blocker {
  id             String          @id
  title          String
  description    String
  severity       BlockerSeverity @default(MEDIUM)
  status         BlockerStatus   @default(open)
  impact         String
  identifiedDate String
  resolvedDate   String?
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("blockers")
}


